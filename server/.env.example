# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/socialpilot
# For MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@cluster.mongodb.net/socialpilot

# JWT Secret (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS - Frontend URL (change for production deployment)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for fast inference - LLaMA 3.3 70B)
# Get it at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
